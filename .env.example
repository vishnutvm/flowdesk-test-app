# FlowDesk environment variables
# Copy this file to `.env.local` for local development. `.env.local` is
# gitignored — never commit real values.

# MongoDB Atlas (or any MongoDB) connection string, including the database
# name in the path (e.g. "/flowdesk"). Required for any page/route that reads
# or writes business data (projects, tasks, team members, customers, etc.) —
# see the "Database setup" section in README.md. Auth (login/signup/session)
# stays fully mocked and does not use this.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowdesk?retryWrites=true&w=majority
MONGODB_URI=

# URL of the real chatbot widget's embed script, used to swap in the actual
# widget in place of components/ChatbotPlaceholder.tsx once it's ready.
# Leave unset while ChatbotPlaceholder.tsx is still a placeholder.
# Example: https://cdn.example-chatbot.com/widget.js
NEXT_PUBLIC_CHATBOT_WIDGET_URL=
